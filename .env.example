# =====================================================================
# Matrix LMS — Environment Variables
# Copy this file to `.env` in the project root before running
# `docker compose up --build`. Never commit the real .env file.
# =====================================================================

NODE_ENV=development
PORT=4000

# ---- PostgreSQL ------------------------------------------------------
# These are consumed by BOTH the db service (to initialize the database)
# and the backend service (to connect to it) — see docker-compose.yml.
POSTGRES_DB=matrix_lms
POSTGRES_USER=matrix_admin
POSTGRES_PASSWORD=change_me_in_production
DB_HOST=db
DB_PORT=5432

# ---- JWT ---------------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_string_before_deploying
JWT_EXPIRES_IN=7d

# ---- CORS --------------------------------------------------------------
# Origin allowed to call the API. Use * only for local development.
CORS_ORIGIN=http://localhost:4000

# ---- Demo account passwords ---------------------------------------------
# Used once, on first boot, by backend/src/seed.js to create demo
# admin/instructor/student logins (only runs if the users table is empty).
# Change these — or delete them and set your own — before any real deploy.
SEED_ADMIN_PASSWORD=Admin@12345
SEED_INSTRUCTOR_PASSWORD=Instructor@12345
SEED_STUDENT_PASSWORD=Student@12345
